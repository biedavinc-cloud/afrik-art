{
  "name": "PlanConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "enum": [
        "starter",
        "pro",
        "premium"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple"
      ]
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "media_limit": {
      "type": "number"
    },
    "categories_limit": {
      "type": "number"
    },
    "tagline": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sort": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "key",
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}