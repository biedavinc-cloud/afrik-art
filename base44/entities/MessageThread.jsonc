{
  "name": "MessageThread",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "Profil artiste concern\u00e9"
    },
    "artist_user_id": {
      "type": "string",
      "description": "Compte propri\u00e9taire du profil"
    },
    "artist_name": {
      "type": "string"
    },
    "client_user_id": {
      "type": "string",
      "description": "Compte du client s'il est inscrit, sinon vide"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "collaboration_type": {
      "type": "string",
      "enum": [
        "exposition",
        "achat",
        "commande",
        "presse",
        "collaboration",
        "autre"
      ],
      "enumColors": [
        "purple",
        "green",
        "blue",
        "yellow",
        "pink",
        "gray"
      ],
      "default": "collaboration"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "archived"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "default": "open"
    },
    "last_message": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string"
    },
    "artist_unread": {
      "type": "number",
      "default": 0
    },
    "client_unread": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "default": "profile"
    }
  },
  "required": [
    "profile_id",
    "artist_user_id",
    "client_name",
    "client_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.artist_user_id": "{{user.id}}"
        },
        {
          "data.client_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.artist_user_id": "{{user.id}}"
        },
        {
          "data.client_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}