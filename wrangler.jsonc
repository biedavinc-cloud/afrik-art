{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Le nom doit rester identique à celui du Worker dans le tableau de bord Cloudflare (vérifié : « afrik-art »).
  "name": "afrik-art",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.js",
  "observability": { "enabled": true },

  // Base de données (comptes, sessions, profils, œuvres, messages, paiements…).
  // Créée automatiquement au premier déploiement ; le schéma s'applique tout seul au premier accès.
  "d1_databases": [{ "binding": "DB", "database_name": "afrik-art-db" }],

  // Images envoyées par les utilisateurs. Bucket créé automatiquement au premier déploiement.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "afrik-art-files" }],

  // E-mails (codes de vérification, réinitialisation de mot de passe, notifications) : Cloudflare Email Service.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_URL": "https://afrik.cloud",
    // Adresse expéditrice : le domaine doit être validé dans Cloudflare > Email Service.
    "MAIL_FROM": "noreply@afrik.cloud"
    // SUPERADMIN_EMAILS (adresses des super administrateurs) n'est volontairement PAS ici : le dépôt est public.
    // Définissez-le comme SECRET : Cloudflare > Worker > Settings > Variables and Secrets > Add > type « Secret ».
  }
}
