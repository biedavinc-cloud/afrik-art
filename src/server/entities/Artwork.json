{
  "name": "Artwork",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "photo",
        "video"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "photo"
    },
    "image_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "sort": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "profile_id",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}