{
  "name": "Message",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "artist_user_id": {
      "type": "string"
    },
    "client_user_id": {
      "type": "string"
    },
    "sender_user_id": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "artist",
        "client"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "sender_name": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "read_by_artist": {
      "type": "boolean",
      "default": false
    },
    "read_by_client": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "thread_id",
    "body",
    "sender_role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.artist_user_id": "{{user.id}}"
        },
        {
          "data.client_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.artist_user_id": "{{user.id}}"
        },
        {
          "data.client_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}