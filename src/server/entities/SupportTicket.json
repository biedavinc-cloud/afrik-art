{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "compte",
        "abonnement",
        "paiement",
        "technique",
        "autre"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow",
        "gray"
      ],
      "default": "autre"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "closed"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green"
      ],
      "default": "open"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}